<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#F3F6FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignupActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="417dp"
        android:layout_height="322dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/signupheaderr" />

    <LinearLayout
        android:layout_width="407dp"
        android:layout_height="454dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView">

        <EditText
            android:id="@+id/FullName"
            android:layout_width="322dp"
            android:layout_height="54dp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/logintextbox"
            android:ems="10"
            android:fontFamily="@font/fredoka"
            android:gravity="center_vertical"
            android:hint="Full Name"
            android:inputType="text"
            android:padding="12dp"
            android:textAlignment="textStart"
            android:textColor="#094B78"
            android:textColorHint="#094B78"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/Email"
            android:layout_width="322dp"
            android:layout_height="54dp"
            android:layout_margin="8dp"
            android:background="@drawable/logintextbox"
            android:ems="10"
            android:fontFamily="@font/fredoka"
            android:gravity="center_vertical"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textAlignment="textStart"
            android:textColor="#094B78"
            android:textColorHint="#094B78"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/Password"
            android:layout_width="322dp"
            android:layout_height="54dp"
            android:layout_margin="8dp"
            android:background="@drawable/logintextbox"
            android:ems="10"
            android:fontFamily="@font/fredoka"
            android:gravity="center_vertical"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textAlignment="textStart"
            android:textColor="#094B78"
            android:textColorHint="#094B78"
            android:textSize="16sp" />


        <Button
            android:id="@+id/signupbtn"
            android:layout_width="322dp"
            android:layout_height="54dp"
            android:backgroundTint="#0E75BB"
            android:fontFamily="@font/fredoka_one"
            android:text="Sign up"
            android:textColor="#FFFFFF"
            android:textSize="25dp"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:id="@+id/login"
            android:layout_width="235dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="177dp"
                android:layout_height="20dp"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:text="Already have an account?"
                android:textColor="#094B78" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="58dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka_one"
                android:gravity="center"
                android:text="Log in"
                android:textColor="#0E75BB" />

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>